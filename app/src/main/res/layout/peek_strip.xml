<?xml version="1.0" encoding="utf-8"?>
<!--
  The hinge strip content, written as a normal horizontal line: clock, then notification icons.
  RotatedLayout turns it 90 degrees so it runs along the hinge. peek_mode.xml includes this
  once per screen. The include supplies width/height, so these are placeholders.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal">

    <TextClock
        android:id="@+id/peek_strip_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="#FFFFFF"
        android:textSize="24sp" />

    <LinearLayout
        android:id="@+id/peek_strip_icons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal" />
</LinearLayout>